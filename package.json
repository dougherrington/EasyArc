{
  "name": "easyarc",
  "version": "0.4.0-beta",
  "description": "The easiest way to play your retro game collection",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --mac dmg",
    "build-win": "electron-builder --win nsis",
    "build-win-zip": "electron-builder --win zip --arm64"
  },
  "build": {
    "appId": "com.dougherrington.easyarc",
    "productName": "EasyArc",
    "mac": {
      "category": "public.app-category.games",
      "target": "dmg"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "EasyArc",
      "installerIcon": null,
      "uninstallerIcon": null,
      "artifactName": "EA-Win-Beta-${version}-Setup.exe",
      "include": "resources/installer.nsh"
    },
    "dmg": {
      "title": "EasyArc 0.4.0 Beta",
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/node-hid/**/*",
      "resources/vc_redist.x64.exe"
    ],
    "extraResources": [
      {
        "from": "resources/win/",
        "to": "win/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/retroarch-bundle/",
        "to": "retroarch-bundle/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/ppsspp-bundle/",
        "to": "ppsspp-bundle/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "node_modules/node-hid/**/*",
      "resources/vc_redist.x64.exe"
    ],
    "npmRebuild": false
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "crc-32": "^1.2.2",
    "node-hid": "^3.3.0",
    "yauzl": "^3.3.0"
  }
}
